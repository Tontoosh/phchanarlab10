digraph Bonus {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.6, ranksep=0.55, fontname="DejaVu Sans", fontsize=18, labelloc=t, label="bonus CFG - all-defs stage\n32a/32b: short-circuit OR; 38c/38a: for-each condition / assignment\nEdge labels are actual JUnit method names; dashed red edges are not covered yet"];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#334155", fontname="DejaVu Sans", fontsize=13, margin="0.18,0.1"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#475569", arrowsize=0.8];
  n31 [label="31: bonus(attendance, threshold)"];
  n32a [label="32a: attendance == null?", shape=diamond, fillcolor="#fef3c7"];
  n32b [label="32b: threshold < 0?", shape=diamond, fillcolor="#fef3c7"];
  n33 [label="33: throw IllegalArgumentException", fillcolor="#fee2e2"];
  n35 [label="35: present = 0"];
  n36 [label="36: streak = 0"];
  n37 [label="37: best = 0"];
  n38c [label="38c: attendance has next element?", shape=diamond, fillcolor="#fef3c7"];
  n38a [label="38a: a = next element"];
  n39 [label="39: a > 0?", shape=diamond, fillcolor="#fef3c7"];
  n40 [label="40: present = present + 1"];
  n41 [label="41: streak = streak + 1"];
  n42 [label="42: streak > best?", shape=diamond, fillcolor="#fef3c7"];
  n43 [label="43: best = streak"];
  n46 [label="46: streak = 0"];
  n49 [label="49: score = 0"];
  n50 [label="50: present >= threshold?", shape=diamond, fillcolor="#fef3c7"];
  n51 [label="51: score = 5"];
  n53 [label="53: best >= 5?", shape=diamond, fillcolor="#fef3c7"];
  n54 [label="54: score = score + 3"];
  n56 [label="56: return score", fillcolor="#dcfce7"];
  n31 -> n32a [label="bonusLongBelowThreshold\nbonusResetAtThreshold"];
  n32a -> n33 [label="T\nuncovered at all-defs", color="#dc2626", fontcolor="#b91c1c", style=dashed];
  n32a -> n32b [label="F\nbonusLongBelowThreshold\nbonusResetAtThreshold"];
  n32b -> n33 [label="T\nuncovered at all-defs", color="#dc2626", fontcolor="#b91c1c", style=dashed];
  n32b -> n35 [label="F\nbonusLongBelowThreshold\nbonusResetAtThreshold"];
  n35 -> n36 [label="bonusLongBelowThreshold\nbonusResetAtThreshold"];
  n36 -> n37 [label="bonusLongBelowThreshold\nbonusResetAtThreshold"];
  n37 -> n38c [label="bonusLongBelowThreshold\nbonusResetAtThreshold"];
  n38c -> n38a [label="T\nbonusLongBelowThreshold\nbonusResetAtThreshold"];
  n38c -> n49 [label="F\nbonusLongBelowThreshold\nbonusResetAtThreshold"];
  n38a -> n39 [label="bonusLongBelowThreshold\nbonusResetAtThreshold"];
  n39 -> n40 [label="T\nbonusLongBelowThreshold\nbonusResetAtThreshold"];
  n39 -> n46 [label="F\nbonusResetAtThreshold"];
  n40 -> n41 [label="bonusLongBelowThreshold\nbonusResetAtThreshold"];
  n41 -> n42 [label="bonusLongBelowThreshold\nbonusResetAtThreshold"];
  n42 -> n43 [label="T\nbonusLongBelowThreshold\nbonusResetAtThreshold"];
  n42 -> n38c [label="F\nbonusResetAtThreshold"];
  n43 -> n38c [label="bonusLongBelowThreshold\nbonusResetAtThreshold"];
  n46 -> n38c [label="bonusResetAtThreshold"];
  n49 -> n50 [label="bonusLongBelowThreshold\nbonusResetAtThreshold"];
  n50 -> n51 [label="T\nbonusResetAtThreshold"];
  n50 -> n53 [label="F\nbonusLongBelowThreshold"];
  n51 -> n53 [label="bonusResetAtThreshold"];
  n53 -> n54 [label="T\nbonusLongBelowThreshold"];
  n53 -> n56 [label="F\nbonusResetAtThreshold"];
  n54 -> n56 [label="bonusLongBelowThreshold"];
}
